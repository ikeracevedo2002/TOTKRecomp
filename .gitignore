# Build output
/build/
/build-*/
/out/
/.cache/

# Local developer configuration
/config/local.json
/config/*.local.json
/totkrecomp.local.toml

# Local game data and analysis material; never commit these directories.
/local-game-data/
/targets/totk/local/
/analysis-local/

# Proprietary local game/container material; never add these to the repository.
*.xci
*.nsp
*.nca
*.nso
prod.keys
title.keys
*.keys

# Pi goal/session state and generated reports/logs. Project agent profiles
# are intentionally versioned; runtime goal/session files remain ignored.
/.pi/*
!/.pi/agents/
!/.pi/agents/*.md
*.log
/reports/
/build/generated/
/build/reports/
/build/cache/

# IDE state
.vs/
.vscode/
.idea/
compile_commands.json

# Private local game content and analysis material. NEVER delete, stage, or commit.
# Contains the recovered ExeFS module set (~47 GB). This directory is intentional.
# Do not run `git clean -fdx` or `git reset --hard` without confirming this is preserved.
/local/
.DS_Store
